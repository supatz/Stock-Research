# Frontend configuration (safe to expose in the browser)
VITE_DATA_MODE=snapshot
VITE_DATA_SCHEMA_VERSION=1

# Build-time data configuration (never prefix secrets with VITE_)
MARKET_DATA_SOURCE=yahoo
FMP_API_KEY=
ALLOW_YAHOO_FALLBACK=true
DATA_LOOKBACK_YEARS=3

# Edgar / SEC fair-access identity — NO signup required.
# Just put your name + email (or email alone). Used as the SEC User-Agent.
# Example: Your Name you@example.com
SEC_IDENTITY_EMAIL=

# Reuse cached Edgar financials until this many days old (prices can refresh daily).
EDGAR_MAX_AGE_DAYS=30
